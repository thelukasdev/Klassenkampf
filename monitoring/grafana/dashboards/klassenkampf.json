{
  "uid": "klassenkampf",
  "title": "Klassenkampf",
  "tags": [
    "Klassenkampf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Spieler online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kk_players_online",
          "legendFormat": "Spieler online",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          },
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "Unbekannt"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Aktive Sitzungen",
