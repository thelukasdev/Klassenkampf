              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Speicher des Spielservers",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kk_memory_bytes",
          "legendFormat": "Speicher des Spielservers",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "HTTP-Anfragen pro Sekunde",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(kk_http_requests_total[5m]))",
          "legendFormat": "{{kind}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "HTTP-Antwortzeit (95. Perzentil)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kk_http_duration_seconds_bucket[5m])))",
          "legendFormat": "HTTP-Antwortzeit (95. Perzentil)",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "HTTP-Fehler und Ausnahmen",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(kk_http_errors_total[5m]) + increase(kk_handler_exceptions_total[5m])",
          "legendFormat": "HTTP-Fehler und Ausnahmen",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "title": "Spielerverbindungen",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kk_connections",
          "legendFormat": "Spielerverbindungen",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 99,
      "title": "Geschlossene Spielverbindungen (inkl. Verlassen)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(kk_websocket_disconnects_total[5m])",
          "legendFormat": "Letzte fünf Minuten",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ]
    },
    {
      "id": 15,
      "title": "Aktuelle Warnungen",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(label_replace(((time() - kk_collector_heartbeat_timestamp_seconds > 180) or absent(kk_collector_heartbeat_timestamp_seconds)), \"warnung\", \"Messwert-Sender ausgefallen\", \"\", \"\")) or (label_replace((kk_app_up == 0), \"warnung\", \"Spielserver nicht erreichbar\", \"\", \"\")) or (label_replace((node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes < 0.15), \"warnung\", \"Wenig Arbeitsspeicher\", \"\", \"\")) or (label_replace((kk_disk_avail_bytes / kk_disk_size_bytes < 0.15), \"warnung\", \"Wenig Festplattenspeicher\", \"\", \"\")) or (label_replace((100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) > 85), \"warnung\", \"Hohe CPU-Auslastung\", \"\", \"\")) or (label_replace((kk_worker_error_last_timestamp_seconds > time() - 300), \"warnung\", \"Spielprozess-Fehler\", \"\", \"\")) or (label_replace((increase(kk_http_errors_total[5m]) + increase(kk_handler_exceptions_total[5m]) > 3), \"warnung\", \"HTTP-Fehler\", \"\", \"\"))",
          "instant": true,
          "range": false,
          "format": "table",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_CLOUD}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Aktuelle Grenzwertverletzungen; keine E-Mail-Benachrichtigungen."
    },
    {
      "id": 16,
      "title": "Letzter Messwert",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_CLOUD}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - kk_collector_heartbeat_timestamp_seconds",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          },
          "noValue": "Unbekannt"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "__inputs": [
    {
      "name": "DS_CLOUD",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "description": "Technische Messwerte, jede Minute. Keine personenbezogenen Daten. Warnungen werden nur hier angezeigt."
}
