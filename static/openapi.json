{
  "openapi": "3.0.3",
  "info": {
    "title": "Klassenkampf API",
    "version": "1.0.0",
    "description": "Lesezugriff. Status und Spiele sind öffentlich. Ein separater Bearer-Schlüssel erlaubt anonymisierte Sitzungsübersichten und aggregierte Ergebnisse. Limits je Serverprozess: 600 öffentliche, 120 autorisierte und 60 ungültige Anfragen pro Minute. Keine Verwaltungsaktionen. Ergebnisse umfassen nur die derzeit geladenen Sitzungen; keine vollständige historische Rangliste."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "API-Status abrufen",
        "tags": [
          "Klassenkampf"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "405": {
            "description": "Nur GET erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit erreicht; Retry-After beachten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/games": {
      "get": {
        "operationId": "getGames",
        "summary": "Verfügbare Spiele abrufen",
        "tags": [
          "Klassenkampf"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Games"
                }
              }
            }
          },
          "405": {
            "description": "Nur GET erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit erreicht; Retry-After beachten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sessions": {
      "get": {
        "operationId": "getSessions",
        "summary": "Anonymisierte Sitzungsübersicht abrufen (maximal 200)",
        "tags": [
          "Klassenkampf"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sessions"
                }
              }
            }
          },
          "401": {
            "description": "Bearer-Schlüssel fehlt oder ist ungültig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Nur GET erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit erreicht; Retry-After beachten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "API-Schlüssel noch nicht eingerichtet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/results": {
      "get": {
        "operationId": "getResults",
        "summary": "Abgeschlossene Partien je Spiel zusammenfassen",
        "tags": [
          "Klassenkampf"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Erfolgreich",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Results"
                }
              }
            }
          },
          "401": {
            "description": "Bearer-Schlüssel fehlt oder ist ungültig",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Nur GET erlaubt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Anfragelimit erreicht; Retry-After beachten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "API-Schlüssel noch nicht eingerichtet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separater Integrationsschlüssel. Kein Konto-Passwort oder Verwaltungstoken."
      }
    },
    "schemas": {
      "Status": {
        "type": "object",
        "required": [
          "version",
          "status"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Games": {
        "type": "object",
        "required": [
          "games"
        ],
        "properties": {
          "games": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "min_players",
                "max_players"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "min_players": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_players": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "Sessions": {
        "type": "object",
        "required": [
          "sessions"
        ],
        "properties": {
          "sessions": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "kind",
                "state",
                "online",
                "matches",
                "active"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "online": {
                  "type": "integer",
                  "minimum": 0
                },
                "matches": {
                  "type": "integer",
                  "minimum": 0
                },
                "active": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "Results": {
        "type": "object",
        "required": [
          "completed_matches",
          "games",
          "scope"
        ],
        "properties": {
          "completed_matches": {
            "type": "integer",
            "minimum": 0
          },
          "games": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "completed_matches"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "completed_matches": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "scope": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
